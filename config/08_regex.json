{
  "id": "08_regex",
  "classificacao": "heuristica",
  "prioridade": 4,
  "descricao": "Regex pre-construidas",
  "categorias": {
    "datas": {
      "ano": "(?:19|20)\\d{2}",
      "data_iso": "\\d{4}-\\d{2}-\\d{2}",
      "data_br": "\\d{2}[/-]\\d{2}[/-]\\d{4}",
      "hora": "\\d{2}[:h]\\d{2}"
    },
    "media": {
      "serie": "[sS]\\d{1,2}[eE]\\d{1,2}",
      "versao": "v\\d+(?:\\.\\d+)*"
    },
    "hashes": {
      "md5": "[a-fA-F0-9]{32}",
      "sha1": "[a-fA-F0-9]{40}",
      "sha256": "[a-fA-F0-9]{64}"
    },
    "duplicados": {
      "copia": "(?:copia|copy|\\bcopy\\b)",
      "final": "(?:final|vfinal|_final)",
      "backup": "(?:backup|bak|bkp)",
      "temp": "(?:temp|tmp|~)"
    }
  }
}