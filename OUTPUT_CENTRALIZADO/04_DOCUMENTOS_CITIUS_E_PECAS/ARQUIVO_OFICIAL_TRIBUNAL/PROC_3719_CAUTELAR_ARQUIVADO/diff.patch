+"""Controlador principal do Organizador LEA."""
+import os
+import time
+from modules.scan_files import list_files
+from modules.classify_files import classify_file
+from modules.folder_organizer import move_to_category, ensure_directory_structure
+from ui import UserInterface
+from config import CATEGORIES
+
+def main():
+    # Prepara ambiente
+    ensure_directory_structure()
+    
+    # Obtém arquivos para processar
+    files = list_files()
+    total_files = len(files)
+    
+    if not total_files:
+        print("Nenhum arquivo encontrado para organizar!")
+        return
+    
+    print(f"\nIniciando organização de {total_files} arquivos...")
+    
+    # Processa arquivos
+    stats = {category: 0 for category in CATEGORIES}
+    start_time = time.time()
+    
+    for i, filepath in enumerate(files):
+        UserInterface.show_progress(i+1, total_files, filepath)
+        
+        # Classifica e move arquivo
+        category = classify_file(os.path.basename(filepath))
+        move_to_category(filepath, category)
+        stats[category] += 1
+    
+    # Exibe resultados
+    elapsed = time.time() - start_time
+    print(f"\nProcesso concluído em {elapsed:.2f} segundos")
+    UserInterface.show_summary(stats)
+
+if __name__ == "__main__":
+    main()
