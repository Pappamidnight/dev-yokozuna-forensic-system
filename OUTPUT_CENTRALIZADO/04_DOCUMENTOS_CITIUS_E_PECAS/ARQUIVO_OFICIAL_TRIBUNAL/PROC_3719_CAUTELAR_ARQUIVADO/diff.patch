+"""Classifica arquivos conforme palavras-chave no nome."""
+from config import KEYWORD_MAPPING
+
+def classify_file(filename: str) -> str:
+    """Classifica arquivo baseado em palavras-chave com priorização"""
+    name = (filename or "").lower()
+    
+    # Verificação prioritária para casos especiais
+    if "nsd.prc" in name:
+        return "Processo Judicial"
+    if "casper" in name:
+        return "Contratos"
+    
+    # Verificação no mapeamento geral
+    for key, category in KEYWORD_MAPPING.items():
+        if key.lower() in name:
+            return category
+    
+    return "Outros"
