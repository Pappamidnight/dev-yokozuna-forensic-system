+"""Interface de usuário e relatórios."""
+import os
+from config import CATEGORIES, OUTPUT_DIR
+
+class UserInterface:
+    @staticmethod
+    def show_summary(stats):
+        """Exibe resumo da operação"""
+        print("\nRESUMO DA ORGANIZAÇÃO:")
+        print("======================")
+        for category in CATEGORIES:
+            count = stats.get(category, 0)
+            print(f"{category}: {count} arquivos")
+        
+        total = sum(stats.values())
+        print(f"\nTOTAL: {total} arquivos organizados")
+        print(f"Local: {os.path.abspath(OUTPUT_DIR)}")
+
+    @staticmethod
+    def show_progress(current, total, filename):
+        """Exibe progresso atual"""
+        print(f"[{current}/{total}] Processando: {os.path.basename(filename)}")
