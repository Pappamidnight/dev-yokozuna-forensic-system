+"""Testes para o classificador de arquivos."""
+import unittest
+from modules.classify_files import classify_file
+
+class TestClassify(unittest.TestCase):
+    def test_categorias_prioritarias(self):
+        self.assertEqual(classify_file("Documento_nsd.prc.pdf"), "Processo Judicial")
+        self.assertEqual(classify_file("CASPER_contrato_v1.doc"), "Contratos")
+    
+    def test_financeiro(self):
+        self.assertEqual(classify_file("DRE_2023_Q1.xlsx"), "Financeiro")
+        self.assertEqual(classify_file("Recibo_12345.pdf"), "Financeiro")
+        self.assertEqual(classify_file("transferencias_bancarias.csv"), "Financeiro")
+    
+    def test_processo_judicial(self):
+        self.assertEqual(classify_file("sentenca_do_tribunal.pdf"), "Processo Judicial")
+        self.assertEqual(classify_file("recurso_criminal.doc"), "Processo Judicial")
+    
+    def test_outros(self):
+        self.assertEqual(classify_file("relatorio_final.txt"), "Outros")
+        self.assertEqual(classify_file("documento_sem_palavra_chave.pdf"), "Outros")
+
+if __name__ == "__main__":
+    unittest.main()
