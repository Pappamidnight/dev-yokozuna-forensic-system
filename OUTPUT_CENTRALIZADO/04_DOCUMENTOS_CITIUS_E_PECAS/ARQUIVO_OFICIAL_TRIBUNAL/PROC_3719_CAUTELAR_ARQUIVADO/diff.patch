@@ -0,0 +1,29 @@
+"""Lista arquivos válidos para organização com filtros."""
+import os
+from config import BASE_DIR, IGNORE_EXT, OUTPUT_DIR
+
+def list_files():
+    """Retorna lista de arquivos válidos para processamento"""
+    valid_files = []
+    
+    # Ignora a própria pasta de saída
+    output_base = os.path.basename(OUTPUT_DIR)
+    
+    for root, dirs, files in os.walk(BASE_DIR):
+        # Pula a pasta de saída
+        if output_base in root:
+            continue
+            
+        for file in files:
+            full_path = os.path.join(root, file)
+            
+            # Verifica extensões/nomes a ignorar
+            ignore = any(
+                file.endswith(ext) or file == ext 
+                for ext in IGNORE_EXT
+            )
+            
+            if not ignore:
+                valid_files.append(full_path)
+    
+    return valid_files
